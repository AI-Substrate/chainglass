{
  "name": "@chainglass/harness",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic development harness — Docker + Playwright browser automation for Chainglass",
  "type": "module",
  "bin": {
    "harness": "./bin/harness"
  },
  "scripts": {
    "harness": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@chainglass/positional-graph": "workspace:*",
    "@chainglass/shared": "workspace:*",
    "@chainglass/workflow": "workspace:*",
    "ajv": "^8.20.0",
    "commander": "^13.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "!.next/**/*.map",
        "public/icons/**"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CHAINGLASS_WATCH_POLLING",
        "CHAINGLASS_WATCH_POLL_INTERVAL",
        "CHAINGLASS_FRONT_SECRET",
        "CHAINGLASS_REMOTE_VIEW_ORIGINS"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
